GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
FLOWCHAIN_BUDGET_USD=3
RUNS_DIR=./runs
# Pictures and clips are made on your own GPU endpoints; `npm run runpod:deploy` creates them and fills these in
RUNPOD_API_KEY=
RUNPOD_KEYFRAME_ENDPOINT=
RUNPOD_CLIP_ENDPOINT=
# FLUX 3 klein pictures (optional; README, "FLUX 3 klein pictures"). `npm run runpod:deploy` fills in the endpoint when it is
# run with RUNPOD_PICTURE3_GPUS and HF_TOKEN in the shell; those two are passed through the shell for the deploy only, never set here.
# RUNPOD_PICTURE3_ENDPOINT=
# FLOWCHAIN_IMAGE_MODEL=            flux3 or klein4b
# FLOWCHAIN_CUT_REFERENCES=         on or off (default off)
# Smooth motion, 60 fps (README, "Smooth motion"): shows the choice in the studio when RUNPOD_UPSCALE_ENDPOINT is set. Turn on only after the four runpodInterpolate*/runpodRestoreExtra* prices are in prices.json.
# FLOWCHAIN_SMOOTH_MOTION=          on or off (default off)
# Scene sound (README, "Scene sound"): `npm run runpod:deploy` fills in the endpoint. Turn on only after the three runpodFoley* prices are in prices.json. On a server, npm run server:setup writes both into the worker's settings (run it again after a change) (the web app learns from the worker's health answer).
# RUNPOD_FOLEY_ENDPOINT=
# FLOWCHAIN_SCENE_SOUND=            on or off (default off)
# The voice. With ELEVENLABS_API_KEY set, every new run is spoken by the hosted voice, in the voices chosen
# for each language in assets/voices/elevenlabs.json (`npm run make:voices -- --hosted-candidates <language>`,
# then `--hosted-add`). Without it, by the studio's own voice: `npm run voice:deploy` creates it and fills in
# RUNPOD_VOICE_ENDPOINT, which stays as the fallback.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v3
RUNPOD_VOICE_ENDPOINT=
# FLOWCHAIN_VOICE=narrator-m        one of the studio's voices (src/voice/language.ts)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
