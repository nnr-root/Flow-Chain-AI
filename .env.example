GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
FLOWCHAIN_BUDGET_USD=3
RUNS_DIR=./runs
# Pictures and clips are made on your own GPU endpoints; `npm run runpod:deploy` creates them and fills these in
RUNPOD_API_KEY=
RUNPOD_KEYFRAME_ENDPOINT=
RUNPOD_CLIP_ENDPOINT=
# The studio's own voice: `npm run voice:deploy` creates it and fills this in. With it set, the two
# ELEVENLABS_* settings above are not needed for new runs.
RUNPOD_VOICE_ENDPOINT=
# FLOWCHAIN_VOICE=narrator-m        or narrator-f
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
